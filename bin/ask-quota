#!/usr/bin/env bash
# ask-quota — breakdown quota usage per session (task), from local transcripts.
# usage: ask-quota [days|week|session] [top]
#   week / session = align to the real Anthropic quota window (via quota-axi)
set -euo pipefail
arg=${1:-7} top=${2:-20}

case "$arg" in
  week|session)
    win=$([ "$arg" = week ] && echo seven_day || echo five_hour)
    reset=$(quota-axi --provider claude --json |
            jq -r --arg w "$win" '.providers[0].windows[] | select(.id==$w) | .resetsAt')
    pct=$(quota-axi --provider claude --json |
          jq -r --arg w "$win" '.providers[0].windows[] | select(.id==$w) | .percentUsed')
    span=$([ "$arg" = week ] && echo "7 days" || echo "5 hours")
    since=$(date -u -d "$reset - $span" +%Y-%m-%dT%H:%M:%SZ)
    note="window $arg: $since → $reset  (quota-axi: ${pct}% used)"
    ;;
  *)
    since=$(date -u -d "$arg days ago" +%Y-%m-%dT%H:%M:%SZ)
    note="last $arg days (since $since)"
    ;;
esac

echo "$note"

find ~/.claude/projects -name '*.jsonl' -newermt "$since" -print0 |
xargs -0 -r -n1 jq -n -r -c --arg since "$since" '
  [ inputs ] as $all |
  # only messages inside the window — a session may span the window boundary
  ( $all | map(select(.message.usage and .timestamp >= $since)) ) as $rows |
  select($rows | length > 0) |
  # dedupe: every assistant message is written ~3x per transcript
  ( $rows | map(select(.message.id)) | group_by(.message.id) | map(.[0]) ) as $msgs |
  {
    file: input_filename,
    label: ( $rows[0].cwd // input_filename ),
    # judul task = prompt user pertama yang bukan slash-command / caveat / hook / tool-result
    task: ( $all
            | map(select(.type == "user" and (.isMeta | not))
                  | .message.content
                  | if type == "string" then . else (map(select(.type == "text") | .text) | join(" ")) end)
            | map(select(test("^\\s*(<(command-|local-command|user-prompt|session-start|task-notification)|This session is being continued)") | not))
            | map(select(length > 0)) | first // "-" ),
    inp:   ( $msgs | map(.message.usage.input_tokens // 0)                | add // 0 ),
    out:   ( $msgs | map(.message.usage.output_tokens // 0)               | add // 0 ),
    cw:    ( $msgs | map(.message.usage.cache_creation_input_tokens // 0) | add // 0 ),
    cr:    ( $msgs | map(.message.usage.cache_read_input_tokens // 0)     | add // 0 )
  }
  # cost units ~ Anthropic price ratios: read .1x, write 1.25x, output 5x of input
  | . + { cost: (.inp + .cw*1.25 + .cr*0.1 + .out*5) }
' |
jq -s -r --argjson top "$top" --arg pct "${pct:-}" '
  (map(.cost) | add // 1) as $total |
  ($pct | if . == "" then null else tonumber end) as $quota |
  ( ["COST_KU","SHARE","QUOTA","OUT","CACHE_W","CACHE_R","PROJECT","TASK"],
    (sort_by(-.cost) | .[:$top] | .[] |
      [ (.cost/1000|round),
        ((.cost/$total*100)|round|tostring+"%"),
        (if $quota then ((.cost/$total*$quota*10|round)/10|tostring+"%") else "-" end),
        (.out/1000|round|tostring+"k"), (.cw/1000|round|tostring+"k"), (.cr/1000|round|tostring+"k"),
        (.label | sub("^/home/[^/]+/";"~/") | split("/") | .[-2:] | join("/")),
        (.task | gsub("\\s+";" ") | .[0:55]) ])
    | @tsv
  )
' | column -t -s$'\t'
